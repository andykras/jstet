{
  "name": "ot60",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "serve": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint --ext .js,.vue src",
    "test:unit": "node --test tests/unit/*.test.js"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^1.2.18",
    "@fortawesome/free-solid-svg-icons": "^5.8.2",
    "@fortawesome/vue-fontawesome": "^3.3.3",
    "register-service-worker": "^1.6.2",
    "vue": "^3.5.0",
    "vuex": "^4.1.0",
    "mitt": "^3.0.1"
  },
  "devDependencies": {
    "vite": "^7.3.7",
    "vite-plugin-pwa": "^1.3.0",
    "stylus": "^0.64.0",
    "eslint": "^8.57.1",
    "eslint-plugin-vue": "^9.33.0",
    "@vitejs/plugin-vue": "^6.0.10"
  },
  "prettier": {
    "semi": false,
    "singleQuote": true,
    "trailingComma": "none",
    "tabWidth": 2,
    "printWidth": 140
  },
  "eslintConfig": {
    "root": true,
    "globals": {
      "JSON5": "readonly"
    },
    "env": {
      "node": true
    },
    "extends": [
      "plugin:vue/essential"
    ],
    "rules": {
      "newline-per-chained-call": [
        "error",
        {
          "ignoreChainWithDepth": 10
        }
      ],
      "vue/max-attributes-per-line": [
        "error",
        {
          "singleline": {
            "max": 1
          },
          "multiline": {
            "max": 1
          }
        }
      ],
      "vue/no-use-v-if-with-v-for": [
        "error",
        {
          "allowUsingIterationVar": true
        }
      ],
      "space-before-function-paren": [
        "error",
        "never"
      ],
      "no-console": 0,
      "comma-dangle": [
        "error",
        "never"
      ],
      "semi": [
        "error",
        "never"
      ],
      "quotes": [
        "error",
        "single"
      ],
      "max-len": [
        "error",
        {
          "code": 140
        }
      ],
      "indent": [
        "error",
        2,
        {
          "SwitchCase": 1
        }
      ],
      "no-unused-vars": [
        "error",
        {
          "args": "after-used",
          "argsIgnorePattern": "^_"
        }
      ]
    },
    "parserOptions": {
      "ecmaVersion": 2022,
      "sourceType": "module"
    }
  },
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
