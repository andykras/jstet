{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jstet-leaderboard",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "vars": {
    "ALLOWED_ORIGINS": "https://tetcolor.andykras.org,http://localhost:1337,http://127.0.0.1:1337"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "jstet-leaderboard",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ]
}
