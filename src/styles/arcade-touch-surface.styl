// Full-surface phone controls. Button controls remain available as a setting.
.mobile-touch-surface
  display none

@media (max-width: 920px)
  .jstet-app.touch-mode-gestures .game-layout
    grid-template-areas 'stage'
    grid-template-rows minmax(0, 1fr)

  .jstet-app.touch-mode-gestures .touch-pad
    display none

  .mobile-touch-surface
    position absolute
    inset 0
    z-index 4
    display block
    overflow hidden
    border-radius inherit
    touch-action none
    user-select none
    -webkit-user-select none
    -webkit-tap-highlight-color transparent
    overscroll-behavior contain

    &--inactive
      pointer-events none

    &__hints
      position absolute
      inset 0
      pointer-events none

    &__hint
      position absolute
      display inline-block
      padding 7px 9px
      border 1px solid rgba(156, 205, 255, .4)
      border-radius 9px
      background rgba(12, 22, 45, .79)
      box-shadow 0 0 18px rgba(92, 187, 255, .12)
      color #d6f4ff
      font-family ui-monospace, 'SFMono-Regular', Consolas, monospace
      font-size clamp(9px, 2.2vw, 12px)
      font-weight 800
      letter-spacing .06em
      white-space nowrap
      text-shadow 0 0 10px rgba(89, 207, 255, .3)
      transform translate(-50%, -50%)

      &--left
        left unquote('calc(var(--mobile-rail, 64px) / 2)')
        top 47%

      &--right
        left unquote('calc(100% - var(--mobile-rail, 64px) / 2)')
        top 47%

      &--rotate
        left 50%
        top 40%

      &--drop
        left 50%
        top 68%
        color #ffe1a9
        border-color rgba(255, 195, 127, .45)

    &__warp
      position absolute
      width 82px
      height 82px
      margin-left -41px
      margin-top -41px
      border 1px solid rgba(179, 239, 255, .6)
      border-radius 50%
      pointer-events none
      background radial-gradient(circle, rgba(232, 251, 255, .14) 0%, rgba(99, 197, 255, .13) 32%, transparent 72%)
      box-shadow inset 0 0 14px rgba(210, 244, 255, .31), 0 0 19px rgba(112, 206, 255, .2)
      backdrop-filter blur(2.5px) saturate(1.5)
      -webkit-backdrop-filter blur(2.5px) saturate(1.5)
      animation touch-surface-warp 320ms cubic-bezier(.18, .7, .2, 1) both

      &::after
        content ''
        position absolute
        inset 12px
        border 1px solid rgba(214, 247, 255, .42)
        border-radius 50%
        background radial-gradient(circle, transparent 33%, rgba(192, 243, 255, .13) 63%, transparent 75%)

  .touch-hint-fade-leave-active
    transition opacity 720ms ease, filter 720ms ease

  .touch-hint-fade-leave-to
    opacity 0
    filter blur(5px)

@keyframes touch-surface-warp
  0%
    opacity 0
    transform scale(.3)
  25%
    opacity .95
  100%
    opacity 0
    transform scale(1.65)

@media (prefers-reduced-motion: reduce)
  .mobile-touch-surface__warp
    animation none
    opacity 0

  .touch-hint-fade-leave-active
    transition none
