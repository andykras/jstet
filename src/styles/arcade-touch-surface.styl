// Mobile input occupies the whole play panel; legacy buttons stay available.
.mobile-touch-surface
  display none

@media (max-width: 920px)
  .jstet-app.touch-mode-gestures .game-layout
    grid-template-areas 'stage'
    grid-template-rows minmax(0, 1fr)

  .jstet-app.touch-mode-gestures .touch-pad
    display none

  .mobile-touch-surface
    position absolute
    inset 0
    z-index 4
    display block
    overflow hidden
    border-radius inherit
    touch-action none
    user-select none
    -webkit-user-select none
    -webkit-tap-highlight-color transparent
    overscroll-behavior contain

    &--inactive
      pointer-events none

    &__hints
      position absolute
      inset 0
      pointer-events none

    &__hint
      position absolute
      display inline-flex
      align-items center
      justify-content center
      gap 6px
      opacity .60
      min-height 46px
      padding 9px 11px
      border 1px solid rgba(162, 205, 255, .32)
      border-radius 12px
      background linear-gradient(150deg, rgba(32, 44, 79, .54), rgba(12, 24, 51, .50))
      box-shadow inset 0 1px rgba(255, 255, 255, .06), 0 5px 15px rgba(6, 13, 32, .17)
      color #ecf8ff
      font-family ui-monospace, 'SFMono-Regular', Consolas, monospace
      font-size clamp(12px, 3vw, 15px)
      font-weight 900
      letter-spacing .045em
      line-height 1
      white-space nowrap
      text-shadow 0 0 9px rgba(110, 201, 255, .25)
      transform translate(-50%, -50%)

      &--left
        left unquote('calc(var(--mobile-rail, 64px) / 2)')
        top 47%

      &--right
        left unquote('calc(100% - var(--mobile-rail, 64px) / 2)')
        top 47%

      &--rotate
        left 50%
        top 40%

      &--drop
        left 50%
        top 68%
        padding 10px 15px
        border-color rgba(255, 199, 127, .34)
        color #ffe6b5
        background linear-gradient(150deg, rgba(70, 42, 62, .58), rgba(31, 25, 55, .54))

    &__hint-icon
      flex 0 0 auto
      width clamp(26px, 7vw, 34px)
      height clamp(26px, 7vw, 34px)
      overflow visible
      filter drop-shadow(0 0 5px rgba(141, 218, 255, .22))

      &--drop
        width clamp(29px, 7.5vw, 37px)
        height clamp(29px, 7.5vw, 37px)
        filter drop-shadow(0 0 5px rgba(255, 189, 106, .25))

    // Quiet concentric contours surround the lens, without the old neon target.
    &__warp
      position absolute
      pointer-events none
      border-radius 50%
      box-shadow none

      &::after
        content ''
        position absolute
        inset 17%
        border 1px solid rgba(210, 246, 255, .16)
        border-radius 50%
        box-shadow inset 0 0 8px rgba(180, 226, 255, .04)

      &--tap
        width 100px
        height 100px
        margin-left -50px
        margin-top -50px
        border 1px solid rgba(184, 232, 255, .22)
        background radial-gradient(circle, rgba(218, 248, 255, .12), rgba(112, 205, 255, .04) 46%, transparent 76%)
        box-shadow inset 0 0 11px rgba(167, 228, 255, .065)
        backdrop-filter blur(3px) saturate(1.65) contrast(1.1)
        -webkit-backdrop-filter blur(3px) saturate(1.65) contrast(1.1)
        mask-image radial-gradient(circle, #000 0%, rgba(0, 0, 0, .82) 40%, rgba(0, 0, 0, .55) 100%)
        -webkit-mask-image radial-gradient(circle, #000 0%, rgba(0, 0, 0, .82) 40%, rgba(0, 0, 0, .55) 100%)
        animation touch-surface-lens 280ms ease-out both

      // A downward flick gets a softer, elongated optical trail.
      &--swipe
        width 82px
        height 108px
        margin-left -41px
        margin-top -54px
        border 1px solid rgba(184, 226, 255, .17)
        background linear-gradient(180deg, transparent 4%, rgba(206, 242, 255, .08) 43%, transparent 92%)
        box-shadow inset 0 0 10px rgba(169, 229, 255, .045)
        backdrop-filter blur(1.6px) saturate(1.25)
        -webkit-backdrop-filter blur(1.6px) saturate(1.25)
        mask-image radial-gradient(ellipse, #000 6%, rgba(0, 0, 0, .7) 46%, rgba(0, 0, 0, .6) 100%)
        -webkit-mask-image radial-gradient(ellipse, #000 6%, rgba(0, 0, 0, .7) 46%, rgba(0, 0, 0, .6) 100%)
        animation touch-surface-swipe 300ms ease-out both

  .touch-hint-fade-leave-active
    transition opacity 720ms ease, filter 720ms ease

  .touch-hint-fade-leave-to
    opacity 0
    filter blur(5px)

@keyframes touch-surface-lens
  0%
    opacity 0
    transform scale(.68)
  26%
    opacity .9
  100%
    opacity 0
    transform scale(1.13)

@keyframes touch-surface-swipe
  0%
    opacity 0
    transform translateY(-13px) scaleY(.7)
  26%
    opacity .65
  100%
    opacity 0
    transform translateY(21px) scaleY(1.15)

@media (prefers-reduced-motion: reduce)
  .mobile-touch-surface__warp
    animation none
    opacity 0

  .touch-hint-fade-leave-active
    transition none
