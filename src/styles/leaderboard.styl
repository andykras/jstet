.leaderboard-backdrop
  position fixed
  inset 0
  z-index 110
  display flex
  align-items center
  justify-content center
  padding 16px
  background rgba(4, 7, 20, .83)
  backdrop-filter blur(12px)

.leaderboard-dialog
  width min(100%, 560px)
  max-height min(92dvh, 850px)
  overflow-y auto
  padding clamp(18px, 3vw, 28px)
  border 1px solid var(--panel-border)
  border-radius 20px
  background linear-gradient(154deg, #242042, #0c152d 80%)
  box-shadow 0 30px 100px rgba(0, 0, 0, .6)
  color #f9f4ff

  &:focus
    outline none

.leaderboard-header
  display flex
  justify-content space-between
  align-items flex-start
  gap 12px
  margin-bottom 18px

  h2
    margin 5px 0 0
    font-size clamp(23px, 5vw, 32px)
    letter-spacing .05em

.leaderboard-kicker
  color var(--arcade-orange)
  font-size 10px
  font-weight 800
  letter-spacing .2em

.leaderboard-tabs
  display flex
  gap 6px
  padding 4px
  margin-bottom 10px
  border 1px solid rgba(180, 149, 245, .25)
  border-radius 12px
  background rgba(8, 13, 31, .72)

  button
    flex 1 1 0
    min-height 35px
    border 0
    border-radius 8px
    background transparent
    color #c4b9dc
    font inherit
    font-size 13px
    font-weight 700
    cursor pointer

    &[aria-pressed='true']
      background rgba(247, 178, 77, .19)
      color var(--arcade-orange)

    &:focus-visible
      outline 2px solid var(--arcade-orange)
      outline-offset 2px

.leaderboard-tabs--period button
  font-size 12px

.leaderboard-period-note
  margin 12px 0
  color #b9b4d0
  font-size 12px
  line-height 1.5

.leaderboard-list
  display grid
  gap 5px
  margin 0
  padding 0
  list-style none

.leaderboard-entry
  display grid
  grid-template-columns 30px minmax(0, 1fr) auto
  align-items center
  gap 12px
  min-height 43px
  padding 9px 13px
  border-radius 10px
  background rgba(29, 35, 66, .75)

  &:first-child
    background rgba(152, 112, 37, .23)

  &:nth-child(2)
    background rgba(126, 129, 163, .16)

  &:nth-child(3)
    background rgba(150, 90, 59, .16)

.leaderboard-entry--mine
  outline 1px solid rgba(131, 223, 250, .75)
  background rgba(26, 79, 106, .52)

.leaderboard-entry__rank
  color var(--arcade-orange)
  font-weight 800
  font-variant-numeric tabular-nums

.leaderboard-entry__name
  min-width 0
  overflow-wrap anywhere
  font-size 14px
  font-weight 700

  small
    margin-left 8px
    color #83dcfb
    font-size 9px

.leaderboard-entry__score
  color #fff3dd
  font-size 14px
  font-variant-numeric tabular-nums

.leaderboard-personal
  display grid
  grid-template-columns 1fr 1fr
  gap 14px
  margin-top 15px
  padding 16px
  border 1px solid rgba(102, 188, 246, .28)
  border-radius 12px
  background rgba(22, 61, 87, .36)

  > div
    display flex
    flex-direction column
    gap 5px

  span
    color #9ad8ed
    font-size 11px

  strong
    color #f0faff
    font-size 22px
    font-variant-numeric tabular-nums

.leaderboard-notice
  display flex
  flex-direction column
  align-items flex-start
  gap 10px
  margin 16px 0
  padding 15px
  border 1px solid rgba(176, 143, 235, .24)
  border-radius 10px
  color #ddd1ef
  font-size 13px
  line-height 1.5

.leaderboard-publish
  margin-top 18px
  padding-top 18px
  border-top 1px solid rgba(190, 145, 238, .25)

  h3
    margin 0 0 10px
    color var(--arcade-orange)
    font-size 12px
    letter-spacing .06em

  p
    margin 7px 0 13px
    color #c6b8df
    font-size 12px
    line-height 1.5

  form
    display grid
    gap 10px

    label
      font-size 13px
      font-weight 700

    input
      width 100%
      min-height 40px
      padding 9px 12px
      border 1px solid rgba(181, 155, 236, .56)
      border-radius 9px
      background #11182e
      color #fff
      font inherit

    button
      justify-self start

.leaderboard-publish .leaderboard-error
  color #ffb3bf

.leaderboard-disclaimer
  margin 17px 0 0
  color #9c96b9
  font-size 11px
  line-height 1.5

@media (max-width: 480px)
  .leaderboard-backdrop
    padding 7px

  .leaderboard-dialog
    max-height 96dvh
    padding 16px
    border-radius 14px

  .leaderboard-entry
    gap 7px
    padding 9px 8px

  .leaderboard-entry__name,
  .leaderboard-entry__score
    font-size 12px

.leaderboard-local
  display flex
  align-items center
  justify-content space-between
  gap 12px
  padding 11px 14px
  margin 12px 0
  border 1px solid rgba(255, 209, 122, .25)
  border-radius 11px
  background rgba(231, 174, 91, .08)

  span
    color #c7c0d6
    font-size 10px
    font-weight 800
    line-height 1.4
    letter-spacing .07em

  strong
    color var(--arcade-orange)
    font-size 22px
    font-variant-numeric tabular-nums

.leaderboard-preferences
  display flex
  align-items center
  flex-wrap wrap
  justify-content space-between
  gap 9px
  margin-top 10px
  padding 10px 2px

  label
    display flex
    align-items center
    gap 8px
    font-size 12px
    color #ddd2ed
    cursor pointer

  input
    width 17px
    height 17px
    accent-color var(--arcade-orange)

  .leaderboard-error
    flex 1 0 100%

.leaderboard-text-action
  min-height 28px
  padding 3px 0
  border 0
  background transparent
  color #b2d8ed
  font inherit
  font-size 11px
  text-decoration underline
  text-underline-offset 3px
  cursor pointer

  &:hover
    color #e3f6ff

  &:focus-visible
    outline 2px solid var(--arcade-orange)
    outline-offset 3px

.game-state-overlay__record
  margin 8px 0
  color var(--arcade-orange)
  font-size 13px
  font-weight 900
  letter-spacing .13em
  text-shadow 0 0 15px rgba(255, 191, 104, .26)

@media (max-width: 420px)
  // Four header actions must fit without stealing height from the game well.
  .arcade-brand__mark
    display none

  .arcade-brand__name
    font-size 16px
    letter-spacing .01em

  .arcade-header
    gap 3px

  .header-actions
    gap 2px

  .header-actions .arcade-button
    width 33px
    height 35px

  .header-action__icon
    width 16px
    height 16px

  .leaderboard-personal
    gap 8px
    padding 12px

  .leaderboard-personal strong
    font-size 19px

@media (min-width: 921px) and (max-width: 1180px)
  // Preserve horizontal space for the mode selector on small desktops.
  .header-actions .arcade-button
    flex 0 0 auto
    width 41px
    height 40px
    min-width 0
    padding 7px

  .header-action__label
    display none

  .header-action__icon
    display block
    width 19px
    height 19px
