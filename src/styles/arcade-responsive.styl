// Viewport-first play area: preserve square cells and prioritize the actual board.
.jstet-app
  height 100dvh
  min-height 0
  overflow hidden
  padding clamp(7px, 1.1vmin, 14px)

.arcade-console
  display flex
  flex-direction column
  height 100%
  min-height 0
  padding clamp(10px, 1.5vmin, 18px)

// Legacy owns its own controls and can use the natural document height.
.jstet-app.is-lab
  height auto
  min-height 100dvh
  overflow visible

.is-lab .arcade-console
  height auto
  min-height 0
  overflow visible

.arcade-header
  flex 0 0 auto
  gap clamp(8px, 1.3vw, 20px)
  padding-bottom clamp(7px, 1vh, 11px)

.mode-switch
  flex-shrink 0
  gap 2px

.mode-switch__button
  white-space nowrap

// Three purposeful columns: skyline + HUD, well, and next piece.
.game-layout
  flex 1 1 0
  min-height 0
  max-height 100%
  width 100%
  max-width 1280px
  margin 0 auto
  padding-top clamp(8px, 1.2vh, 14px)
  display grid
  grid-template-areas 'dashboard board preview'
  grid-template-columns minmax(205px, .83fr) minmax(0, 1.45fr) minmax(142px, .49fr)
  grid-template-rows minmax(0, 1fr)
  align-items stretch
  gap clamp(8px, 1.3vw, 16px)

.dashboard-column
  grid-area dashboard
  position relative
  isolation isolate
  min-width 0
  min-height 0
  overflow hidden
  border 2px solid rgba(252, 113, 164, 0.91)
  border-radius 18px
  background #170f30
  box-shadow 0 0 0 2px rgba(249, 139, 201, 0.16), 0 0 28px rgba(235, 70, 159, 0.21)

.dashboard-column::after
  content ''
  position absolute
  z-index 0
  inset 0 0 auto
  height 53%
  pointer-events none
  background linear-gradient(180deg, rgba(9, 8, 29, .87), rgba(17, 9, 39, .65) 60%, transparent)

.dashboard-column .cityscape-column
  grid-area auto
  position absolute
  z-index -1
  inset 0
  display block
  width 100%
  height 100%
  min-height 0
  border 0
  border-radius inherit
  box-shadow none

.dashboard-column .game-hud
  grid-area auto
  position relative
  z-index 1
  display grid
  grid-template-columns repeat(2, minmax(0, 1fr))
  align-content start
  gap clamp(6px, 1vh, 10px)
  height auto
  min-height 0
  padding clamp(8px, 1.2vh, 13px)
  border 0
  background transparent
  box-shadow none

.dashboard-column .game-hud .hud-stat
  flex none
  grid-column auto
  min-width 0
  min-height 67px
  padding clamp(8px, 1vh, 12px)
  gap 5px
  background rgba(9, 10, 32, .85)
  backdrop-filter blur(5px)

.dashboard-column .game-hud .hud-stat--score
  grid-column 1 / -1
  min-height 84px

.dashboard-column .game-hud .hud-stat--bonus
  grid-column 1 / -1
  min-height 57px

.dashboard-column .game-hud .hud-stat__number
  margin-top auto
  font-size clamp(21px, 2.3vw, 29px)

.dashboard-column .game-hud .hud-stat__number--score
  font-size clamp(27px, 2.7vw, 35px)

.dashboard-column .level-meter
  margin-top 1px

.board-panel
  grid-area board
  align-self stretch
  width 100%
  height 100%
  min-width 0
  min-height 0
  padding clamp(8px, 1.1vh, 14px)

.board-panel__top
  flex 0 0 auto
  min-width 0
  padding-bottom 8px
  margin-bottom 0

.board-panel__well
  // Container units represent actual free space after the panel heading.
  container-type size
  flex 1 1 0
  width 100%
  min-width 0
  min-height 0

.board-panel__well .tetcolor-board
  // Rendered columns = well width - 2, rows = well height - 1.
  --jstet-cell-size unquote('max(1px, min(38px, calc((100cqw - 14px) / var(--board-columns, 7)), calc((100cqh - 14px) / var(--board-rows, 18))))')
  flex 0 0 auto
  max-width 100%
  max-height 100%

.next-panel
  grid-area preview
  align-self start
  display flex
  flex-direction column
  justify-content space-between
  width 100%
  height auto
  min-height clamp(130px, 24vh, 190px)
  padding clamp(10px, 1.4vh, 17px)

.next-panel .next-piece
  --jstet-cell-size: clamp(16px, 2.5vh, 26px)
  margin auto

// Explicit widths prevent Stylus from folding min() into the full viewport.
.settings-backdrop
  display flex
  justify-content center
  align-items center
  padding 16px

.arcade-dialog
  flex 0 1 430px
  width 430px
  max-width 100%
  min-width 0
  height auto
  max-height calc(100dvh - 32px)
  overflow-y auto
  padding 20px
  border-radius 17px

.settings-group
  gap 10px
  margin-top 14px
  padding-top 13px

.settings-group legend
  margin-bottom 8px

.settings-hint
  font-size 11px

.dialog-actions
  margin-top 15px

.game-state-overlay__body
  width 320px
  max-width 100%

// A smaller cabinet keeps its decorative image and statistics together.
@media (min-width: 921px) and (max-width: 1200px)
  .game-layout
    grid-template-columns minmax(190px, .77fr) minmax(0, 1.5fr) minmax(132px, .5fr)

// Tablets and phones: statistics in a row, board in the center, controls below.
@media (max-width: 920px)
  .jstet-app
    padding 6px

  .arcade-console
    padding 9px

  .arcade-header
    gap 7px
    padding-bottom 7px

  .game-layout
    grid-template-areas 'dashboard preview' 'board board' 'touch touch'
    grid-template-columns minmax(0, 1fr) minmax(82px, .27fr)
    grid-template-rows auto minmax(0, 1fr) auto
    gap 7px
    padding-top 7px
    justify-items stretch

  .dashboard-column
    position static
    height auto
    overflow visible
    border 0
    border-radius 0
    background transparent
    box-shadow none

  .dashboard-column::after,
  .dashboard-column .cityscape-column
    display none

  .dashboard-column .game-hud
    position static
    display flex
    align-items stretch
    width 100%
    height auto
    padding 0
    gap 5px

  .dashboard-column .game-hud .hud-stat,
  .dashboard-column .game-hud .hud-stat--score,
  .dashboard-column .game-hud .hud-stat--bonus
    flex 1 1 0
    min-width 0
    min-height 52px
    padding 6px
    gap 5px
    border-radius 9px

  .dashboard-column .game-hud .hud-stat__number,
  .dashboard-column .game-hud .hud-stat__number--score
    font-size clamp(15px, 2.8vw, 24px)

  .dashboard-column .level-meter
    display none

  .next-panel
    height auto
    min-height 0
    padding 6px 8px

  .next-panel .panel-heading
    font-size 11px

  .next-panel .next-piece
    --jstet-cell-size: clamp(12px, 2.5vw, 20px)
    margin 4px auto 0

  .board-panel
    justify-self center
    max-width 540px
    padding 7px

  .board-panel__top
    padding-bottom 6px

  .touch-pad
    position static
    z-index 8
    display flex
    width 100%
    max-width 540px
    min-height 0
    margin 0 auto
    padding 6px
    gap 12px

  .touch-pad__directions
    grid-template-columns repeat(3, minmax(44px, 56px))
    grid-template-rows repeat(2, 47px)
    gap 5px

  .touch-pad__drop
    flex-basis 100px
    min-height 99px

// A narrow portrait header still holds all three modes without scrolling.
@media (max-width: 640px) and (orientation: portrait)
  .jstet-app
    padding 5px
    padding-bottom unquote('max(5px, env(safe-area-inset-bottom))')

  .arcade-console
    padding 7px

  .arcade-header
    display grid
    grid-template-columns minmax(0, 1fr) auto
    gap 5px 6px
    padding-bottom 5px

  .arcade-brand
    min-width 0
    gap 4px

  .arcade-brand__name
    font-size clamp(17px, 5vw, 25px)

  .arcade-brand__mark
    transform scale(.72)
    transform-origin left center
    margin-right -6px

  .mode-switch
    order initial
    width auto
    padding 2px

  .mode-switch__button
    min-height 28px
    padding 5px 6px
    font-size 10px

  .header-actions
    order initial
    grid-column 1 / -1
    flex 0 0 auto
    width 100%
    gap 5px

  .header-actions .arcade-button
    flex 1 1 0
    min-width 0
    min-height 34px
    padding 5px 4px
    border-radius 9px
    font-size clamp(10px, 2.8vw, 12px)
    white-space nowrap

  .game-layout
    grid-template-columns minmax(0, 1fr) minmax(73px, .3fr)
    gap 5px
    padding-top 5px

  .dashboard-column .game-hud
    gap 4px

  .dashboard-column .game-hud .hud-stat,
  .dashboard-column .game-hud .hud-stat--score,
  .dashboard-column .game-hud .hud-stat--bonus
    min-height 46px
    padding 5px 4px
    border-radius 8px

  .dashboard-column .game-hud .hud-stat__number,
  .dashboard-column .game-hud .hud-stat__number--score
    font-size clamp(13px, 3.4vw, 18px)

  .hud-stat__label,
  .dashboard-column .game-hud .panel-heading
    font-size 9px

  .next-panel
    padding 5px 7px

  .next-panel .next-piece
    --jstet-cell-size: clamp(11px, 3.2vw, 16px)

  .board-panel
    padding 5px
    border-radius 12px

  .board-panel__top
    padding-bottom 4px

  .board-panel__top .panel-eyebrow
    font-size 9px

  .touch-pad
    gap 7px
    padding 5px
    border-radius 11px

  .touch-pad__directions
    grid-template-columns repeat(3, minmax(40px, 51px))
    grid-template-rows repeat(2, 42px)
    gap 4px

  .touch-pad__key
    font-size 24px
    border-radius 9px

  .touch-pad__drop
    flex-basis 86px
    min-height 88px
    border-radius 9px
    font-size 12px

  .touch-pad__drop-icon
    font-size 26px

// On a short landscape screen use an adjacent touch pad rather than scrolling.
@media (max-width: 920px) and (max-height: 520px) and (orientation: landscape)
  .arcade-header
    display flex
    flex-wrap nowrap
    gap 6px

  .arcade-brand
    flex 0 1 auto

  .arcade-brand__name
    font-size 19px

  .mode-switch
    order initial

  .mode-switch__button
    min-height 29px
    padding 4px 6px
    font-size 10px

  .header-actions
    order initial
    flex 1 1 auto
    width auto
    gap 4px

  .header-actions .arcade-button
    min-height 30px
    padding 4px
    font-size 10px

  .game-layout
    grid-template-areas 'board dashboard' 'board touch'
    grid-template-columns minmax(0, 1.3fr) minmax(215px, 1fr)
    grid-template-rows auto minmax(0, 1fr)

  .board-panel
    max-width none

  .dashboard-column .game-hud .hud-stat,
  .dashboard-column .game-hud .hud-stat--score,
  .dashboard-column .game-hud .hud-stat--bonus
    min-height 43px
    padding 4px

  .next-panel
    display none

  .touch-pad
    align-self center

  .touch-pad__directions
    grid-template-columns repeat(3, 42px)
    grid-template-rows repeat(2, 40px)

  .touch-pad__drop
    min-height 84px
    flex-basis 70px

// If controls and readable cells cannot fit, allow scrolling rather than clipping.
@media (max-width: 640px) and (max-height: 560px) and (orientation: portrait)
  .jstet-app:not(.is-lab)
    height auto
    min-height 100dvh
    overflow visible

  .jstet-app:not(.is-lab) .arcade-console
    height auto
    overflow visible

  .game-layout
    flex none
    min-height 620px
    grid-template-rows auto minmax(340px, 1fr) auto

  .touch-pad
    position sticky
    bottom unquote('max(5px, env(safe-area-inset-bottom))')
