@import './game-cells.styl'

:root
  color-scheme dark

*
  box-sizing border-box

html,
body,
#app
  margin 0
  min-width 0
  min-height 100%
  width 100%

body
  background #080b1a

.jstet-app
  --jstet-cell-size: clamp(18px, 3.7vh, 34px)
  --panel-bg: rgba(18, 23, 49, 0.9)
  --panel-border: rgba(135, 120, 190, 0.44)
  --arcade-orange: #ffc358
  --arcade-violet: #d477ff
  min-height 100dvh
  padding clamp(8px, 1.8vw, 28px)
  font-family Inter, 'Helvetica Neue', Helvetica, Arial, sans-serif
  color #f8f3ff
  background radial-gradient(ellipse at 16% 80%, rgba(138, 38, 143, 0.3), transparent 44%), radial-gradient(ellipse at 90% 18%, rgba(42, 74, 147, 0.38), transparent 51%), #080b1a
  -webkit-font-smoothing antialiased

.arcade-console
  position relative
  width min(100%, 1440px)
  min-height calc(100dvh - 56px)
  margin 0 auto
  padding clamp(12px, 2vw, 26px)
  border 1px solid rgba(211, 119, 255, 0.55)
  border-radius clamp(16px, 2.2vw, 30px)
  background radial-gradient(ellipse at 20% 100%, rgba(111, 38, 105, 0.18), transparent 42%), linear-gradient(148deg, #12132e, #090e25 75%)
  box-shadow 0 12px 52px rgba(0, 0, 0, 0.38), inset 0 1px rgba(255, 255, 255, 0.09)
  overflow hidden

.arcade-console > *
  position relative

.arcade-header
  display flex
  align-items center
  gap clamp(10px, 2vw, 28px)
  padding 0 0 clamp(14px, 2vw, 22px)
  border-bottom 1px solid rgba(189, 143, 250, 0.2)

.arcade-brand
  display flex
  align-items center
  gap 12px
  flex 1 1 auto
  min-width 0

.arcade-brand__name
  font-size clamp(25px, 3vw, 36px)
  font-weight 900
  font-style italic
  font-stretch condensed
  letter-spacing 0.08em
  color #fff8ff
  text-shadow 0 0 16px rgba(218, 106, 255, 0.45)

.arcade-brand__mark
  position relative
  display grid
  grid-template-columns repeat(3, 8px)
  grid-template-rows repeat(3, 8px)
  gap 2px
  transform rotate(0deg)

  i
    display block
    background #ffbaff
    box-shadow 0 0 12px rgba(236, 99, 246, 0.55)

  i:nth-child(1)
    grid-column 2
    grid-row 1

  i:nth-child(2)
    grid-column 1
    grid-row 2

  i:nth-child(3)
    grid-column 2
    grid-row 2

  i:nth-child(4)
    grid-column 3
    grid-row 2

.mode-indicator
  display flex
  align-items center
  justify-content center
  gap 8px
  flex 0 0 auto
  padding 9px 18px
  border 1px solid rgba(255, 197, 78, 0.53)
  border-radius 99px
  background rgba(252, 171, 54, 0.1)
  color #ffe3a3
  font-size 12px
  font-weight 800
  letter-spacing 0.08em
  text-transform uppercase

.mode-indicator__dot
  width 7px
  height 7px
  border-radius 50%
  background #ffc55b
  box-shadow 0 0 12px #ffa72a

.header-actions
  display flex
  flex 1 0 auto
  align-items center
  justify-content flex-end
  gap 10px

.arcade-button
  display inline-flex
  justify-content center
  align-items center
  gap 8px
  min-height 40px
  padding 9px 17px
  border 1px solid rgba(177, 139, 246, 0.58)
  border-radius 13px
  background rgba(57, 39, 100, 0.7)
  color #fbf5ff
  font inherit
  font-size 14px
  font-weight 700
  cursor pointer
  transition background 160ms ease, border-color 160ms ease, transform 160ms ease

  &:hover:not(:disabled)
    border-color #e89fff
    background rgba(113, 63, 157, 0.75)

  &:active:not(:disabled)
    transform translateY(1px)

  &:disabled
    opacity 0.44
    cursor not-allowed

  &:focus-visible
    outline 2px solid var(--arcade-orange)
    outline-offset 3px

.arcade-button--primary
  border-color #ffc95f
  background linear-gradient(145deg, #ffd86f, #ffad32)
  color #241326

  &:hover:not(:disabled)
    background linear-gradient(145deg, #ffe89c, #ffc14b)
    border-color #ffe89c

.game-layout
  display grid
  grid-template-areas 'stats board preview' 'stats board guide'
  grid-template-columns minmax(180px, 236px) minmax(0, 1fr) minmax(186px, 246px)
  grid-template-rows auto 1fr
  align-items start
  gap clamp(12px, 1.8vw, 22px)
  width min(100%, 1150px)
  margin clamp(14px, 1.8vw, 24px) auto 0

.arcade-panel
  min-width 0
  padding clamp(14px, 2vw, 22px)
  border 1px solid var(--panel-border)
  border-radius 18px
  background var(--panel-bg)
  box-shadow inset 0 1px rgba(255, 255, 255, 0.07), 0 12px 32px rgba(0, 0, 0, 0.18)

.panel-heading
  margin 0
  color #ffc968
  font-size 12px
  font-weight 800
  letter-spacing 0.12em
  text-transform uppercase

.panel-eyebrow
  color #c3aecb
  font-size 10px
  font-weight 700
  letter-spacing 0.16em

.stats-column
  grid-area stats

.game-hud
  display grid
  gap 16px

.hud-stat
  display flex
  flex-direction column
  gap 8px
  padding 0 0 16px
  border-bottom 1px solid rgba(162, 137, 216, 0.18)

  &:last-child
    border-bottom none
    padding-bottom 0

.hud-stat__label
  color #c6b8e7
  font-size 11px
  font-weight 700
  text-transform uppercase
  letter-spacing 0.12em

.hud-stat__number
  font-size clamp(22px, 3vw, 30px)
  font-weight 800
  line-height 1
  font-variant-numeric tabular-nums
  color #fdfaff

.hud-stat__number--score
  color #ffd17a
  font-size clamp(28px, 3.6vw, 40px)

.hud-stat--bonus .hud-stat__number
  color #eaa1ff

.board-panel
  grid-area board
  display flex
  flex-direction column
  align-items center
  min-width 0
  padding clamp(12px, 1.8vw, 20px)
  border 1px solid rgba(214, 127, 255, 0.42)
  border-radius 20px
  background linear-gradient(150deg, rgba(34, 31, 76, 0.72), rgba(8, 13, 30, 0.95))
  box-shadow 0 18px 42px rgba(4, 5, 18, 0.23)

.board-panel__top,
.board-panel__bottom
  display flex
  align-items center
  justify-content space-between
  width 100%
  gap 12px

.board-panel__top
  padding-bottom 14px

.board-panel__bottom
  padding-top 14px
  color #c2b8d9
  font-size 11px
  font-weight 600
  letter-spacing 0.03em

.game-status
  padding 5px 9px
  border-radius 99px
  background rgba(98, 190, 143, 0.09)
  color #9df0b4
  font-size 10px
  font-weight 800
  letter-spacing 0.06em

.game-status--paused
  color #ffd082
  background rgba(241, 154, 44, 0.12)

.game-status--gameOver
  color #ffc1ce
  background rgba(223, 62, 103, 0.13)

.board-panel__well
  display flex
  align-items center
  justify-content center
  max-width 100%

.preview-column
  grid-area preview

.next-panel
  display flex
  flex-direction column
  align-items stretch
  min-height 138px

.next-piece
  --jstet-cell-size: 24px
  display flex
  flex-direction column-reverse
  width max-content
  margin 14px auto 0

.next-piece__row
  display flex

.next-piece .game-cell:not(.item)
  background transparent
  box-shadow none

.guide-column
  grid-area guide

  p
    margin 9px 0 0
    color #d9cde9
    font-size 13px
    line-height 1.6

  h3
    margin 0 0 12px
    font-size 11px
    letter-spacing 0.1em
    text-transform uppercase
    color #c7b1e5

.guide-divider
  width 100%
  height 1px
  background rgba(191, 137, 249, 0.21)
  margin 16px 0

.control-guide
  display grid
  gap 8px
  margin 0

  > div
    display flex
    justify-content space-between
    align-items center
    gap 12px

  dt,
  dd
    margin 0
    font-size 12px

  dd
    color #c6b8e1

kbd
  display inline-block
  min-width 24px
  padding 3px 5px
  border 1px solid rgba(179, 151, 230, 0.4)
  border-radius 5px
  background rgba(46, 43, 91, 0.8)
  color #f8efff
  text-align center
  font-family inherit
  font-size 11px

.arcade-footer
  display flex
  align-items center
  justify-content space-between
  gap 12px
  margin-top clamp(14px, 1.8vw, 24px)
  padding-top 14px
  border-top 1px solid rgba(191, 137, 249, 0.18)
  color #b4a6ce
  font-size 11px

.arcade-footer__help
  margin 0

.lab-entry
  flex 0 0 auto
  position relative

  summary
    cursor pointer
    color #b7a9cf
    text-decoration underline
    text-underline-offset 3px

  &[open]
    padding 4px 8px
    background rgba(42, 35, 81, 0.85)
    border-radius 8px

    label
      display flex
      align-items center
      gap 8px
      padding 10px 0
      cursor pointer

.lab-layout
  overflow auto
  padding 14px 0
  text-align center

.lab-layout__notice
  color #d5b7e4
  font-size 12px
  margin 0 0 16px

@media (max-width: 920px)
  .jstet-app
    --jstet-cell-size: clamp(16px, 3.7vh, 30px)

  .arcade-header
    flex-wrap wrap

  .arcade-brand
    flex 1 1 auto

  .header-actions
    flex 0 0 100%
    width 100%

  .header-actions .arcade-button
    flex 1 1 auto

  .game-layout
    grid-template-areas 'stats preview' 'board board' 'guide guide'
    grid-template-columns minmax(0, 1fr) minmax(110px, 0.7fr)
    grid-template-rows auto auto auto

  .game-hud
    grid-template-columns repeat(2, minmax(0, 1fr))
    gap 10px

  .hud-stat--score
    grid-column 1 / -1

  .hud-stat--bonus
    grid-column 1 / -1

  .hud-stat
    padding 0
    border 0

  .hud-stat__number
    font-size clamp(17px, 4.8vw, 25px)

  .hud-stat__number--score
    font-size clamp(21px, 6vw, 31px)

  .next-panel
    min-height 100%

  .board-panel
    padding 12px

  .guide-column
    display grid
    grid-template-columns minmax(0, 1fr) minmax(130px, 0.7fr)
    gap 12px

    h2
      grid-column 1

    p
      grid-column 1
      margin-top 0

    .guide-divider
      display none

    h3
      grid-column 2
      grid-row 1

    .control-guide
      grid-column 2
      grid-row 2 / 4

@media (max-width: 480px)
  .jstet-app
    padding 6px

  .arcade-console
    padding 12px
    border-radius 17px

  .arcade-header
    gap 12px

  .arcade-brand__name
    font-size 25px

  .arcade-brand__mark
    transform scale(0.82)
    transform-origin left center
    margin-right -5px

  .mode-indicator
    font-size 10px
    padding 8px 10px

  .arcade-panel
    padding 12px
    border-radius 13px

  .game-layout
    gap 10px

  .game-hud
    gap 9px

  .hud-stat
    gap 4px

  .hud-stat__label,
  .panel-heading
    font-size 10px

  .next-panel
    min-height 106px

  .next-piece
    --jstet-cell-size: 19px
    margin-top 8px

  .board-panel
    border-radius 14px
    padding 9px

  .board-panel__top
    padding-bottom 10px

  .board-panel__bottom
    font-size 10px
    padding-top 10px

  .guide-column
    display block

    p
      font-size 12px

    h3
      margin-top 14px

  .control-guide
    grid-template-columns repeat(2, minmax(0, 1fr))

  .arcade-footer
    align-items flex-start

  .arcade-footer__help
    line-height 1.6

@media (prefers-reduced-motion: reduce)
  .arcade-button
    transition none
