// The phone layout is a single play surface with four corner indicators.
// It deliberately overrides earlier stacked tablet rules in arcade-responsive.styl.
.header-action__icon
  display none

@media (max-width: 920px)
  .arcade-header
    display flex
    flex-wrap nowrap
    justify-content space-between
    align-items center
    gap clamp(3px, .9vw, 9px)

  .arcade-brand
    flex 0 0 auto
    width auto
    gap 6px

  .arcade-brand__name
    font-size clamp(18px, 3vw, 25px)

  .mode-switch
    order initial
    display flex
    flex 1 1 auto
    width auto
    min-width 0
    padding 2px
    gap 1px

  .mode-switch__button
    flex 1 1 auto
    min-width 0
    min-height 32px
    padding 5px 3px
    white-space nowrap
    font-size clamp(9px, 1.65vw, 12px)

  .header-actions
    order initial
    display flex
    flex 0 0 auto
    width auto
    gap 4px
    justify-content flex-end

  .header-actions .arcade-button
    flex 0 0 auto
    width clamp(32px, 4.7vw, 40px)
    height clamp(32px, 4.7vw, 40px)
    min-height 0
    padding 0
    border-radius 10px

  .header-action__label
    display none

  .header-action__icon
    display block
    width 19px
    height 19px

  // Board, live metrics and next preview occupy one grid area.
  .game-layout
    --mobile-rail: clamp(68px, 23vw, 180px)
    --mobile-card-width: calc(var(--mobile-rail) - 12px)
    grid-template-areas 'stage' 'touch'
    grid-template-columns minmax(0, 1fr)
    grid-template-rows minmax(0, 1fr) auto
    gap 8px
    width 100%
    max-width none
    min-height 0

  .board-panel
    grid-area stage
    position relative
    z-index 1
    display flex
    align-items center
    justify-content center
    width 100%
    max-width none
    height 100%
    min-height 0
    padding 8px

  .board-panel__top,
  .board-panel__bottom
    display none

  .board-panel__well
    width unquote('calc(100% - var(--mobile-rail) - var(--mobile-rail) - 12px)')
    height 100%
    min-height 0
    flex 1 1 0

  // The city art is desktop-only; mobile metrics frame the board corners.
  .dashboard-column
    grid-area stage
    position relative
    z-index 2
    align-self stretch
    justify-self stretch
    width 100%
    height 100%
    min-width 0
    min-height 0
    padding 0
    border 0
    border-radius 0
    background transparent
    box-shadow none
    overflow visible
    pointer-events none

  .dashboard-column::after,
  .dashboard-column .cityscape-column
    display none

  .dashboard-column .game-hud
    display block
    position absolute
    inset 0
    width 100%
    height 100%
    margin 0
    padding 0
    border 0
    background transparent
    box-shadow none

  .dashboard-column .game-hud .hud-stat,
  .dashboard-column .game-hud .hud-stat--score,
  .dashboard-column .game-hud .hud-stat--bonus
    position absolute
    display flex
    flex-direction column
    grid-column auto
    width var(--mobile-card-width)
    min-width 0
    min-height 0
    height auto
    margin 0
    padding clamp(6px, 1.25vw, 12px)
    gap 4px
    border-radius 12px
    background linear-gradient(155deg, rgba(26, 18, 48, .98), rgba(8, 11, 35, .97))
    backdrop-filter none
    box-shadow inset 0 1px rgba(255, 209, 135, .12), 0 0 17px rgba(230, 115, 69, .11)

  .dashboard-column .game-hud .hud-stat--score
    left 9px
    bottom 9px

  .dashboard-column .game-hud .hud-stat--level
    right 9px
    top 9px

  .dashboard-column .game-hud .hud-stat--progress
    right 9px
    bottom 9px

  .dashboard-column .game-hud .hud-stat--bonus
    right 9px
    top 89px

  .dashboard-column .game-hud .hud-stat__number,
  .dashboard-column .game-hud .hud-stat__number--score
    margin-top 0
    font-size clamp(17px, 3vw, 29px)
    line-height 1.1

  .dashboard-column .game-hud .hud-stat__label,
  .dashboard-column .game-hud .panel-heading
    font-size clamp(9px, 1.5vw, 13px)

  .dashboard-column .level-meter
    display none

  .next-panel
    grid-area stage
    position relative
    z-index 3
    align-self start
    justify-self start
    width var(--mobile-card-width)
    min-width 0
    min-height 0
    height auto
    margin 9px 0 0 9px
    padding clamp(6px, 1.25vw, 12px)
    border-radius 12px
    pointer-events none

  .next-panel .panel-heading
    font-size clamp(9px, 1.5vw, 13px)

  .next-panel .next-piece
    --jstet-cell-size: clamp(10px, 1.9vw, 17px)
    margin 6px auto 0

  // Thumb controls are split: rotation/drop on the left, movement on the right.
  .touch-pad
    grid-area touch
    position static
    z-index 4
    display flex
    justify-content space-between
    align-items stretch
    width 100%
    max-width none
    min-height 0
    margin 0
    padding 0 2px
    gap 10px
    border 0
    border-radius 0
    background transparent
    box-shadow none

  .touch-pad__left,
  .touch-pad__right
    display flex
    align-items stretch
    gap clamp(4px, 1.4vw, 9px)
    min-width 0

  .touch-pad__key,
  .touch-pad__drop
    flex 0 0 auto
    width clamp(45px, 9.7vw, 62px)
    height clamp(48px, 10vw, 65px)
    min-height 0
    border-radius 11px

  .touch-pad__key
    font-size clamp(25px, 5vw, 36px)

  .touch-pad__key--left,
  .touch-pad__key--right,
  .touch-pad__key--rotate
    grid-column auto
    grid-row auto

  .touch-pad__drop
    width clamp(56px, 12vw, 75px)
    flex-basis auto
    gap 1px
    font-size clamp(10px, 1.6vw, 13px)
    letter-spacing .05em

  .touch-pad__drop-icon
    font-size clamp(24px, 5vw, 34px)
    line-height 1

  // Paused state overlays the entire board including its indicators.
  .jstet-app.is-paused .board-panel
    z-index 5

@media (max-width: 640px)
  .arcade-brand
    flex 0 0 22px

  .arcade-brand__name
    display none

  .arcade-brand__mark
    transform scale(.78)
    transform-origin left center
    margin-right 0

  .mode-switch__button
    font-size clamp(9px, 2.35vw, 11px)
    padding 5px 2px

  .header-actions .arcade-button
    width clamp(29px, 8.5vw, 37px)
    height clamp(31px, 8.5vw, 37px)

  .header-action__icon
    width 17px
    height 17px

  .game-layout
    gap 6px
    padding-top 5px

  .board-panel
    padding 5px

  .dashboard-column .game-hud .hud-stat,
  .dashboard-column .game-hud .hud-stat--score,
  .dashboard-column .game-hud .hud-stat--bonus
    padding 6px 5px
    border-radius 9px

  .dashboard-column .game-hud .hud-stat__number,
  .dashboard-column .game-hud .hud-stat__number--score
    font-size clamp(16px, 4vw, 22px)

  .next-panel
    border-radius 9px
    padding 6px 5px

  .touch-pad__key,
  .touch-pad__drop
    height clamp(46px, 12vw, 55px)

@media (max-width: 370px)
  .game-layout
    --mobile-rail: clamp(66px, 22vw, 78px)

  .arcade-header
    gap 3px

  .mode-switch__button
    font-size 9px

  .touch-pad__left,
  .touch-pad__right
    gap 4px

  .touch-pad
    gap 6px

  .touch-pad__key
    width 44px

  .touch-pad__drop
    width 55px

// Landscape keeps both thumb groups accessible without squeezing the header.
@media (max-width: 920px) and (max-height: 520px) and (orientation: landscape)
  .arcade-brand__name
    display none

  .arcade-brand
    display flex
    flex 0 0 22px

  .game-layout
    grid-template-areas 'stage' 'touch'
    grid-template-columns minmax(0, 1fr)
    grid-template-rows minmax(0, 1fr) auto
    gap 4px

  .touch-pad__key,
  .touch-pad__drop
    height 42px

  .touch-pad__drop-icon
    font-size 22px

  .dashboard-column .game-hud .hud-stat--bonus
    top 71px

// Extremely short portrait windows may scroll, never clip playable cells.
@media (max-width: 640px) and (max-height: 560px) and (orientation: portrait)
  .game-layout
    min-height 520px
    grid-template-rows minmax(420px, 1fr) auto

  .touch-pad
    position sticky
    bottom unquote('max(5px, env(safe-area-inset-bottom))')
