// Bonus feedback is visible in every theme, even when optional Visual FX is off.
// Render over the cleared group, rise gently and dissolve without blocking play.
.tetcolor-board .bonus-reward-layer
  position absolute
  inset 0
  z-index 4
  overflow hidden
  pointer-events none

.tetcolor-board .bonus-reward
  position absolute
  top unquote('clamp(78px, calc(var(--reward-row) * var(--jstet-cell-size)), calc(100% - 78px))')
  left unquote('clamp(68px, calc(var(--reward-column) * var(--jstet-cell-size)), calc(100% - 68px))')
  display flex
  flex-direction column
  align-items center
  justify-content center
  gap 1px
  min-width 118px
  max-width 94%
  pointer-events none
  white-space nowrap
  color #fff4cb
  filter drop-shadow(0 3px 2px rgba(24, 7, 35, .8)) drop-shadow(0 0 12px rgba(255, 163, 47, .55))
  animation bonus-reward-rise 1250ms cubic-bezier(.16, .73, .34, 1) both

  &__kind
    font-family ui-monospace, 'SFMono-Regular', Consolas, monospace
    font-size clamp(11px, 2.6vw, 17px)
    font-weight 900
    letter-spacing .21em
    color #ffde9b
    text-shadow 0 0 9px rgba(255, 191, 82, .9)

  &__streak
    font-family ui-rounded, system-ui, sans-serif
    font-size clamp(42px, 10vw, 70px)
    font-weight 1000
    line-height 1
    letter-spacing -.055em
    color #fffaf0
    -webkit-text-stroke .75px #ffb75b
    text-shadow 0 2px 0 #ad5639, 0 0 14px rgba(255, 217, 105, .7)

  &__points
    font-family ui-rounded, system-ui, sans-serif
    font-size clamp(26px, 6.2vw, 42px)
    font-weight 900
    line-height 1.1
    font-variant-numeric tabular-nums
    color #ffd879
    text-shadow 0 1px 0 #8e4c30, 0 0 12px rgba(255, 189, 56, .75)

  &--cascade
    filter drop-shadow(0 3px 2px rgba(8, 21, 45, .9)) drop-shadow(0 0 14px rgba(68, 216, 255, .65))

    .bonus-reward__kind
      color #a7efff
      text-shadow 0 0 9px rgba(102, 222, 255, .85)

    .bonus-reward__streak
      -webkit-text-stroke .75px #74defd
      text-shadow 0 2px 0 #246c99, 0 0 15px rgba(101, 225, 255, .73)

    .bonus-reward__points
      color #baf8ff
      text-shadow 0 1px 0 #246c99, 0 0 12px rgba(83, 208, 255, .8)

@keyframes bonus-reward-rise
  0%
    opacity 0
    transform translate(-50%, -38%) scale(.76)
  16%
    opacity 1
    transform translate(-50%, -53%) scale(1.07)
  58%
    opacity 1
    transform translate(-50%, -67%) scale(1)
  82%
    opacity .82
  100%
    opacity 0
    transform translate(-50%, -116%) scale(.95)

// Reduced motion keeps the reward readable but does not animate its travel.
.jstet-app.reduce-motion .tetcolor-board .bonus-reward
  animation none
  transform translate(-50%, -50%)

@media (prefers-reduced-motion: reduce)
  .tetcolor-board .bonus-reward
    animation none
    transform translate(-50%, -50%)
