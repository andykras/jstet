// Bonus feedback is visible in every theme, even when optional Visual FX is off.
// Offset rewards above and outward from the cleared group, then fade gently.
.tetcolor-board .bonus-reward-layer
  position absolute
  inset 0
  z-index 4
  overflow visible
  pointer-events none

.tetcolor-board .bonus-reward
  position absolute
  top unquote('calc(var(--reward-row) * var(--jstet-cell-size))')
  left unquote('calc(var(--reward-column) * var(--jstet-cell-size))')
  display flex
  flex-direction column
  align-items center
  justify-content center
  gap 1px
  min-width 118px
  max-width 94%
  pointer-events none
  white-space nowrap
  color #fff4cb
  filter drop-shadow(0 3px 2px rgba(24, 7, 35, .48)) drop-shadow(0 0 8px rgba(255, 163, 47, .26))
  animation bonus-reward-rise 1250ms cubic-bezier(.16, .73, .34, 1) both

  &__kind
    font-family ui-monospace, 'SFMono-Regular', Consolas, monospace
    font-size clamp(11px, 2.6vw, 17px)
    font-weight 900
    letter-spacing .21em
    color #fbdc9f
    text-shadow 0 0 7px rgba(255, 191, 82, .42)

  &__streak
    font-family ui-rounded, system-ui, sans-serif
    font-size clamp(42px, 10vw, 70px)
    font-weight 1000
    line-height 1
    letter-spacing -.055em
    color #fff5e0
    -webkit-text-stroke .5px rgba(255, 183, 91, .75)
    text-shadow 0 2px 0 rgba(143, 66, 43, .5), 0 0 10px rgba(255, 217, 105, .34)

  &__points
    font-family ui-rounded, system-ui, sans-serif
    font-size clamp(26px, 6.2vw, 42px)
    font-weight 900
    line-height 1.1
    font-variant-numeric tabular-nums
    color #ffdfa2
    text-shadow 0 1px 0 rgba(142, 76, 48, .52), 0 0 9px rgba(255, 189, 56, .35)

  &--cascade
    filter drop-shadow(0 3px 2px rgba(8, 21, 45, .55)) drop-shadow(0 0 9px rgba(68, 216, 255, .30))

    .bonus-reward__kind
      color #a7efff
      text-shadow 0 0 7px rgba(102, 222, 255, .42)

    .bonus-reward__streak
      -webkit-text-stroke .5px rgba(116, 222, 253, .7)
      text-shadow 0 2px 0 rgba(36, 108, 153, .5), 0 0 10px rgba(101, 225, 255, .35)

    .bonus-reward__points
      color #baf8ff
      text-shadow 0 1px 0 rgba(36, 108, 153, .5), 0 0 9px rgba(83, 208, 255, .36)

@keyframes bonus-reward-rise
  0%
    opacity 0
    transform translate(-50%, -38%) scale(.76)
  16%
    opacity .76
    transform translate(-50%, -53%) scale(1.05)
  58%
    opacity .76
    transform translate(-50%, -67%) scale(1)
  82%
    opacity .50
  100%
    opacity 0
    transform translate(-50%, -116%) scale(.95)

// Reduced motion keeps the reward readable but does not animate its travel.
.jstet-app.reduce-motion .tetcolor-board .bonus-reward
  animation none
  transform translate(-50%, -50%)
  opacity .76

@media (prefers-reduced-motion: reduce)
  .tetcolor-board .bonus-reward
    animation none
    transform translate(-50%, -50%)
    opacity .76
